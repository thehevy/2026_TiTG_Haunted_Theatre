[Unit]
Description=Haunted House Central Controller
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/haunt-controller
EnvironmentFile=/opt/haunt-controller/.env
ExecStart=/opt/haunt-controller/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
User=haunt
Group=haunt

[Install]
WantedBy=multi-user.target
